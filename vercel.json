{
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://node.ambassador.seyori.name.ng:2011/api/:path*" },
    { "source": "/dl/:path*", "destination": "http://node.ambassador.seyori.name.ng:2011/dl/:path*" },
    { "source": "/yuki-md", "destination": "http://node.ambassador.seyori.name.ng:2011/yuki-md" },
    { "source": "/yuki-md.apk", "destination": "/app-debug.apk" }
  ],
  "headers": [
    { "source": "/app-debug.apk", "headers": [
      { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
      { "key": "Content-Disposition", "value": "attachment; filename=\"YUKI-MD.apk\"" }
    ] }
  ]
}

